<mxfile host="app.diagrams.net">
  <diagram name="Pipeline overview" id="pipelineOverview">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="band1" value="1  Build the interaction dataset" style="rounded=1;arcSize=3;absoluteArcSize=0;fillColor=#f2f2ef;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="195" as="geometry" /></mxCell>
        <mxCell id="band2" value="2  Find where the decision is represented (fit on train, chosen on validation)" style="rounded=1;arcSize=3;absoluteArcSize=0;fillColor=#f2f2ef;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="215" width="1000" height="130" as="geometry" /></mxCell>
        <mxCell id="band3" value="3  Test causality" style="rounded=1;arcSize=3;absoluteArcSize=0;fillColor=#f2f2ef;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="365" width="1000" height="155" as="geometry" /></mxCell>
        <mxCell id="questions" value="&lt;b&gt;Questions&lt;/b&gt;&lt;br&gt;MuSiQue&lt;br&gt;+ synthetic&lt;br&gt;(MuSiQue format)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="15" y="46" width="125" height="116" as="geometry" /></mxCell>
        <mxCell id="solver1" value="&lt;b&gt;Solver · Gemma 3 4B&lt;/b&gt;&lt;br&gt;Attempt 1:&lt;br&gt;answers from the&lt;br&gt;paragraphs (A1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe8f6;strokeColor=#2a78d6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="165" y="46" width="160" height="116" as="geometry" /></mxCell>
        <mxCell id="critic" value="&lt;b&gt;Critic · Qwen3 4B&lt;/b&gt;&lt;br&gt;1. answers without&lt;br&gt;seeing A1&lt;br&gt;2. compares with A1,&lt;br&gt;recommends C1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde7d9;strokeColor=#eb6834;fontSize=10;" vertex="1" parent="1"><mxGeometry x="350" y="46" width="180" height="116" as="geometry" /></mxCell>
        <mxCell id="solver2" value="&lt;b&gt;Solver · Gemma 3 4B&lt;/b&gt;&lt;br&gt;Attempt 2: chooses&lt;br&gt;between A1 and C1,&lt;br&gt;shown as two candidates&lt;br&gt;(random order)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe8f6;strokeColor=#2a78d6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="555" y="46" width="185" height="116" as="geometry" /></mxCell>
        <mxCell id="activations" value="&lt;b&gt;Activations&lt;/b&gt;&lt;br&gt;residual stream at the final&lt;br&gt;prompt token, nine layers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="765" y="34" width="220" height="66" as="geometry" /></mxCell>
        <mxCell id="labels" value="&lt;b&gt;Claude Sonnet 4.5 judge&lt;/b&gt;&lt;br&gt;labels each A2: Adoption,&lt;br&gt;Retention, Agreement or Out" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebe3f5;strokeColor=#8f5ccf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="765" y="108" width="220" height="66" as="geometry" /></mxCell>
        <mxCell id="layers" value="&lt;b&gt;Layer-selection probe&lt;/b&gt;&lt;br&gt;Adoption vs Retention&lt;br&gt;on each layer: layer 25 is best" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="715" y="245" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="saes" value="&lt;b&gt;SAEs at layer 25&lt;/b&gt;&lt;br&gt;custom: L1, TopK&lt;br&gt;pretrained: Gemma Scope 2,&lt;br&gt;decoder-adapted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="445" y="245" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="features" value="&lt;b&gt;Feature-selection probe&lt;/b&gt;&lt;br&gt;10 Adoption + 10 Retention features per SAE,&lt;br&gt;plus 100 random feature sets&lt;br&gt;matched on firing frequency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="15" y="245" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="edit" value="&lt;b&gt;Replay attempt 2 with an edit&lt;/b&gt;&lt;br&gt;held-out intervention episodes;&lt;br&gt;layer 25, final prompt token;&lt;br&gt;targeted vs random features, same size (|Δ| = 0.2 |x|)&lt;br&gt;controls: SAE reconstruction, raw activations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe8f6;strokeColor=#2a78d6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="15" y="393" width="400" height="116" as="geometry" /></mxCell>
        <mxCell id="relabel" value="&lt;b&gt;Claude relabels A2&lt;/b&gt;&lt;br&gt;same judge and prompt&lt;br&gt;as the stored labels" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebe3f5;strokeColor=#8f5ccf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="445" y="393" width="240" height="116" as="geometry" /></mxCell>
        <mxCell id="result" value="&lt;b&gt;Flip rate&lt;/b&gt;&lt;br&gt;targeted − random,&lt;br&gt;9 prespecified tests,&lt;br&gt;Holm correction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="715" y="393" width="270" height="116" as="geometry" /></mxCell>
