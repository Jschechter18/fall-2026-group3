<mxfile host="app.diagrams.net">
  <diagram name="Solver-Critic-Validator loop" id="agentArchitecture">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="370" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="inputs" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;question and&lt;br&gt;20 paragraphs,&lt;br&gt;in every Solver&lt;br&gt;and Critic prompt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="15" y="120" width="145" height="120" as="geometry" /></mxCell>
        <mxCell id="solver1" value="&lt;b&gt;Solver · Gemma 3 4B&lt;/b&gt;&lt;br&gt;Attempt 1: answers&lt;br&gt;from the paragraphs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe8f6;strokeColor=#2a78d6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="50" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="blind" value="&lt;b&gt;Critic · Qwen3 4B&lt;/b&gt;&lt;br&gt;Step 1: answers blind,&lt;br&gt;without seeing A1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde7d9;strokeColor=#eb6834;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="230" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="compare" value="&lt;b&gt;Critic · Qwen3 4B&lt;/b&gt;&lt;br&gt;Step 2: compares its&lt;br&gt;answer with A1; returns&lt;br&gt;verdict, C1, explanation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde7d9;strokeColor=#eb6834;fontSize=10;" vertex="1" parent="1"><mxGeometry x="435" y="135" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="solver2" value="&lt;b&gt;Solver · Gemma 3 4B&lt;/b&gt;&lt;br&gt;Attempt 2: chooses&lt;br&gt;between A1 and C1,&lt;br&gt;shown as two candidates&lt;br&gt;in random order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe8f6;strokeColor=#2a78d6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="675" y="135" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="activations" value="&lt;b&gt;Activations&lt;/b&gt;&lt;br&gt;9 layers, at the&lt;br&gt;final prompt&lt;br&gt;token of each&lt;br&gt;Solver attempt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="135" width="110" height="90" as="geometry" /></mxCell>
        <mxCell id="validator" value="&lt;b&gt;Validator · Gemma 3 4B&lt;/b&gt;&lt;br&gt;Does A2 match the gold&lt;br&gt;answer? YES or NO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3f1ea;strokeColor=#1b8a5a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="675" y="270" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="gold" value="&lt;b&gt;Gold answer&lt;/b&gt;&lt;br&gt;and aliases&lt;br&gt;(seen only by&lt;br&gt;the Validator)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6b6b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="270" width="110" height="80" as="geometry" /></mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inputs" target="solver1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="178" y="150" /><mxPoint x="178" y="90" /></Array></mxGeometry></mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inputs" target="blind"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="178" y="210" /><mxPoint x="178" y="270" /></Array></mxGeometry></mxCell>
        <mxCell id="edge3" value="A1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="solver1" target="compare"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="110" /></Array></mxGeometry></mxCell>
        <mxCell id="edge4" value="A1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="solver1" target="solver2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="25" /><mxPoint x="770" y="25" /></Array></mxGeometry></mxCell>
        <mxCell id="edge5" value="its own answer" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="blind" target="compare"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="270" /></Array></mxGeometry></mxCell>
        <mxCell id="edge6" value="C1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="compare" target="solver2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge7" value="A2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="solver2" target="validator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="solver2" target="activations"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontStyle=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gold" target="validator"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
