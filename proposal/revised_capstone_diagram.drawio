        <mxCell id="HJpW883t6l7vqlVxeamP-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Generate Controlled Solver-Critic Interaction Dataset&amp;nbsp;&lt;/b&gt;&lt;div&gt;All three conditions start from Solver Attempt 1&lt;/div&gt;&lt;div&gt;each row = one feedback event with features: question ID, feedback round, correctness flag, accept/reject label&lt;/div&gt;" vertex="1">
