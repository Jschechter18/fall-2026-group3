          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Sparse Autoencoder&amp;nbsp;&lt;/b&gt;&lt;div&gt;Train the SAE using the activations from the best layer as training data&amp;nbsp;&lt;div&gt;- Identify features of interest related to critic feedback&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="175" x="10" y="650" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-19" edge="1" parent="1" source="HJpW883t6l7vqlVxeamP-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HJpW883t6l7vqlVxeamP-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" value="&lt;b&gt;Predictive Modeling:&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Use the sparse features from the SAE in a linear probe.&amp;nbsp;&lt;/li&gt;&lt;li&gt;Use the weights from the linear probe to identify which sparse features seem important&lt;/li&gt;&lt;li&gt;Attempt to predict whether Solver accepts or rejects Critic feedback&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="207.5" x="270" y="630" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-25" edge="1" parent="1" source="HJpW883t6l7vqlVxeamP-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HJpW883t6l7vqlVxeamP-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Controlled Causality Experiment:&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Performed on features selected using the linear probe methodology&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Increase or decrease feature activations during Solver response generation&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Measure change in feedback acceptance&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Compare with control conditions (no intervention, intervention on random features)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="270" x="550" y="620" as="geometry" />
        </mxCell>
        <mxCell id="HJpW883t6l7vqlVxeamP-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" value="&lt;b&gt;Evaluation:&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Behavioral: Feedback acceptance rate and counts of 4 feedback-uptake outcomes (correct/incorrect x accept/reject)&amp;nbsp;&lt;/li&gt;&lt;li&gt;Probe: Prediction performance (AUROC/ F1/ balanced accuracy) on held-out data&lt;/li&gt;&lt;li&gt;Causal: Changes in feedback acceptance after activation patching vs. controls e.g. delta acceptance rate, dose-response (testing activation strengths)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="760" x="34" y="890" as="geometry" />
        </mxCell>
